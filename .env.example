# ──────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:4200   # Frontend URL for CORS
# In production (Vercel), set CLIENT_URL as a project env var to the exact
# deployed frontend domain (e.g. https://ai-planner-ui.vercel.app) — must match
# apps/web/src/environments/environment.prod.ts apiUrl's origin, or requests
# will be blocked by CORS.

# ──────────────────────────────────────────────────────────────
# Database — PostgreSQL / Neon
# Use pooled connection string for serverless (PgBouncer)
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require

# ──────────────────────────────────────────────────────────────
# JWT Secrets — generate with: openssl rand -hex 64
# Use different values for access and refresh!
# ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_me_with_64_random_hex_chars_access
JWT_REFRESH_SECRET=replace_me_with_64_random_hex_chars_refresh

# ──────────────────────────────────────────────────────────────
# Redis — required for Bull job queues (notifications)
# Local dev: brew install redis && redis-server
# Production: Upstash, Redis Cloud, or AWS ElastiCache
# ──────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=               # Leave empty for local dev

# ──────────────────────────────────────────────────────────────
# OpenAI — used for task extraction and AI chat assistant
# Get your key at: https://platform.openai.com/api-keys
# ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ──────────────────────────────────────────────────────────────
# (Optional) Push notifications — e.g. FCM / APNS
# ──────────────────────────────────────────────────────────────
# FCM_SERVER_KEY=
# APNS_KEY=

# ──────────────────────────────────────────────────────────────
# Email — Resend (https://resend.com), used for password reset emails
# Get your API key at: https://resend.com/api-keys
# If RESEND_API_KEY is left unset, emails are logged to the console
# instead of sent (useful for local dev without a Resend account).
# EMAIL_FROM must be a verified sender/domain in your Resend account;
# the default onboarding@resend.dev only works for sending to your own
# Resend account email while testing.
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=AI Planner <onboarding@resend.dev>

# ──────────────────────────────────────────────────────────────
# Google Calendar integration
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# (type: Web application). Add GOOGLE_OAUTH_CALLBACK_URL below as an
# authorized redirect URI, and allow-list the mobile app's custom URL scheme
# (e.g. com.aiplanner.mobile://oauth/callback) as well.
# ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me

# The backend's own HTTPS callback route Google redirects to for the web
# flow. Must exactly match an authorized redirect URI in the Google Cloud
# Console and include the global API prefix.
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/integrations/google-calendar/callback

# Signs the short-lived `state` param used to identify the user during the
# web OAuth redirect (generate with: openssl rand -hex 64)
GOOGLE_OAUTH_STATE_SECRET=replace_me_with_64_random_hex_chars

# AES-256 key (32 bytes / 64 hex chars) used to encrypt stored Google OAuth
# tokens at rest (generate with: openssl rand -hex 32)
GOOGLE_TOKEN_ENCRYPTION_KEY=replace_me_with_64_random_hex_chars
