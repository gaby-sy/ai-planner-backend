# ──────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:4200   # Frontend URL for CORS
# In production (Vercel), set CLIENT_URL as a project env var to the exact
# deployed frontend domain (e.g. https://ai-planner-ui.vercel.app) — must match
# apps/web/src/environments/environment.prod.ts apiUrl's origin, or requests
# will be blocked by CORS.

# ──────────────────────────────────────────────────────────────
# Database — PostgreSQL / Neon
# Use pooled connection string for serverless (PgBouncer)
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require

# ──────────────────────────────────────────────────────────────
# JWT Secrets — generate with: openssl rand -hex 64
# Use different values for access and refresh!
# ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_me_with_64_random_hex_chars_access
JWT_REFRESH_SECRET=replace_me_with_64_random_hex_chars_refresh

# ──────────────────────────────────────────────────────────────
# Redis — required for Bull job queues (notifications)
# Local dev: brew install redis && redis-server
# Production: Upstash, Redis Cloud, or AWS ElastiCache
# ──────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=               # Leave empty for local dev

# ──────────────────────────────────────────────────────────────
# OpenAI — used for task extraction and AI chat assistant
# Get your key at: https://platform.openai.com/api-keys
# ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ──────────────────────────────────────────────────────────────
# (Optional) Push notifications — e.g. FCM / APNS
# ──────────────────────────────────────────────────────────────
# FCM_SERVER_KEY=
# APNS_KEY=
